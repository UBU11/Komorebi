# ---- NeonDB (shared by api-high-freq + api-ai-engine) ----
# postgresql://user:password@host/db?sslmode=require
DATABASE_URL=postgresql://komorebi:komorebi@localhost:5432/komorebi

# ---- Redis (Pub/Sub, rate limit, cache) ----
REDIS_URL=redis://localhost:6379

# ---- api-high-freq (Hono + Bun) ----
PORT_HIGH_FREQ=8787

# ---- api-ai-engine (FastAPI) ----
PORT_AI_ENGINE=8000

# ---- web-frontend (Next.js) ----
NEXT_PUBLIC_API_HIGH_FREQ_URL=http://localhost:8787
NEXT_PUBLIC_API_AI_ENGINE_URL=http://localhost:8000

# ---- AI model (provider-agnostic; picks up any @ai-sdk/* provider later) ----
# MODEL_ID identifies the model, MODEL_BASE_URL points at an OpenAI-compatible
# endpoint (vendor, OpenRouter, local). Vendor-native providers (anthropic,
# google, ...) ignore MODEL_BASE_URL.
MODEL_ID=
MODEL_API_KEY=
MODEL_BASE_URL=
